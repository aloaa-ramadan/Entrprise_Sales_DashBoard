      </column>
      <column caption='TotalOrders' datatype='integer' name='[Calculation_0514330427035654]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Category] : COUNT([Product_Name]) }' />
      </column>
      <column caption='Final_Price' datatype='real' name='[Calculation_0764743443058688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Price]-[Discount]' />
      </column>
      <column caption='Profit_Margin%' datatype='real' name='[Calculation_0764743444062209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1696853633961984] / [Calculation_0764743443058688] * 100' />
      </column>
      <column caption='State_Name' datatype='string' name='[Calculation_0764743457271811]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if[State]= &apos;CA&apos; then &apos;California&apos;&#13;&#10;ELSEIF [State] = &apos;CO&apos; then &apos;Colorado&apos;&#13;&#10;ELSEIF [State] = &apos;FL&apos; then &apos;Florida&apos;&#13;&#10;ELSEIF [State] = &apos;IL&apos; then &apos;Illinois&apos;&#13;&#10;ELSEIF [State] = &apos;MI&apos; then &apos;Michigan&apos;&#13;&#10;ELSEIF [State] = &apos;NY&apos; then &apos;New York&apos;&#13;&#10;ELSEIF [State] = &apos;OR&apos; then &apos;Oregon&apos;&#13;&#10;ELSEIF [State] = &apos;TX&apos; then &apos;Texas&apos;&#13;&#10;ELSEIF [State] = &apos;WA&apos; then &apos;Washington&apos;&#13;&#10;ELSE &apos;NULL&apos;&#13;&#10;END' />
      </column>
      <column caption='Selected_Measure' datatype='real' name='[Calculation_0764743461687302]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0764743461109765]&#13;&#10;&#13;&#10;WHEN &quot;Discount&quot; THEN [Discount]&#13;&#10;WHEN &quot;Profit&quot; THEN [Calculation_1696853633961984]&#13;&#10;WHEN &quot;Quantity&quot; THEN [Quantity]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Top_N_' datatype='real' name='[Calculation_0764743465525260]' role='measure' type='quantitative'>
